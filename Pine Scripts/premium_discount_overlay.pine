//@version=6
indicator('Premium/Discount Overlay (MA + Anchored VWAP + Regression Channel)', overlay = true, max_labels_count = 500)

// ═══════════════════════════════════════════════════════════════════
// INPUTS
// ═══════════════════════════════════════════════════════════════════

lenSMA1 = input.int(43,  'SMA Fast', minval = 1, group = 'Moving Averages', tooltip = 'Fast moving average length in bars.')
lenSMA2 = input.int(200, 'SMA Slow', minval = 1, group = 'Moving Averages', tooltip = 'Slow moving average length in bars.')

regLen  = input.int(150, 'Regression Length (bars)', minval = 20, group = 'Regression Channel',
     tooltip = 'Long lookback keeps channel calm for swing / long-term use.')
regMult = input.float(1.5, 'Regression Deviation Multiplier', step = 0.1, group = 'Regression Channel',
     tooltip = 'Wider = fewer signals; narrower = more signals.')

useAVWAP1 = input.bool(true,  'Show Anchored VWAP #1', group = 'Anchored VWAP')
anchor1    = input.time(timestamp('01 Jan 2023 00:00 +0000'), 'Anchor #1 (UTC)', confirm = true, group = 'Anchored VWAP')
useAVWAP2  = input.bool(false, 'Show Anchored VWAP #2', group = 'Anchored VWAP')
anchor2    = input.time(timestamp('01 Jan 2024 00:00 +0000'), 'Anchor #2 (UTC)', confirm = true, group = 'Anchored VWAP')

showTags      = input.bool(true,  'Show zone-entry labels', group = 'Zone Detection')
premPctRef    = input.float(0.15, 'Premium vs Slow SMA threshold', step = 0.01, group = 'Zone Detection',
     tooltip = '0.15 means price must be +15% above slow SMA to count as Premium.')
labelCooldown = input.int(20, 'Min bars between labels', minval = 1, group = 'Zone Detection',
     tooltip = 'Prevents label clustering on fast timeframes. Raise on 1m-5m charts.')

// ═══════════════════════════════════════════════════════════════════
// COLORS
// ═══════════════════════════════════════════════════════════════════

colSMA2     = color.new(color.rgb( 33, 150, 243),  0)  // blue  — slow SMA 200
colSMA1     = color.new(color.rgb(255, 179,   0),  0)  // gold  — fast SMA 50
colAVWAP    = color.new(color.rgb(180,   0, 255), 25)  // violet — anchored VWAP
colRegFill  = color.new(color.rgb(255, 140,   0), 85)  // amber fill, very translucent
colRegBasis = color.new(color.rgb(158, 158, 158),  0)  // gray  — regression midline
colRegUpper = color.new(color.rgb( 76, 175,  80),  0)  // green — upper band
colRegLower = color.new(color.rgb(244,  67,  54),  0)  // red   — lower band

// ═══════════════════════════════════════════════════════════════════
// MOVING AVERAGES & REGRESSION CHANNEL
// ═══════════════════════════════════════════════════════════════════

smaFast  = ta.sma(close, lenSMA1)
smaSlow  = ta.sma(close, lenSMA2)

regBasis = ta.linreg(close, regLen, 0)
residual = close - regBasis
resStdev = ta.stdev(residual, regLen)
upperCh  = regBasis + regMult * resStdev
lowerCh  = regBasis - regMult * resStdev

// ═══════════════════════════════════════════════════════════════════
// ANCHORED VWAP  (always called unconditionally to keep var state valid)
// ═══════════════════════════════════════════════════════════════════

tp = hlc3

f_avwap(_anchorTime) =>
    var float cumPV = na
    var float cumV  = na
    if barstate.isfirst
        cumPV := na
        cumV  := na
    if time >= _anchorTime
        cumPV := nz(cumPV[1]) + tp * volume
        cumV  := nz(cumV[1])  + volume
    else
        cumPV := na
        cumV  := na
    cumPV / cumV

avwap1Raw = f_avwap(anchor1)
avwap2Raw = f_avwap(anchor2)

avwap1 = useAVWAP1 ? avwap1Raw : na
avwap2 = useAVWAP2 ? avwap2Raw : na

// ═══════════════════════════════════════════════════════════════════
// ZONE LOGIC
// ═══════════════════════════════════════════════════════════════════

pctFrom200 = (close - smaSlow) / smaSlow

isPremium  = pctFrom200 > premPctRef and close > upperCh
isDiscount = close < lowerCh or pctFrom200 < -premPctRef

var bool prevPremium  = false
var bool prevDiscount = false

enteredPremium  = isPremium  and not prevPremium
enteredDiscount = isDiscount and not prevDiscount

prevPremium  := isPremium
prevDiscount := isDiscount

// ═══════════════════════════════════════════════════════════════════
// BACKGROUND ZONE SHADING
// ═══════════════════════════════════════════════════════════════════

bgcolor(isPremium ? color.new(color.red, 91) : isDiscount ? color.new(color.green, 91) : na, title = 'Zone Background')

// ═══════════════════════════════════════════════════════════════════
// PLOTS
// ═══════════════════════════════════════════════════════════════════

pSMA2 = plot(smaSlow,  'SMA Slow',  colSMA2,     2)
pSMA1 = plot(smaFast,  'SMA Fast',  colSMA1,     2)

pRegB = plot(regBasis, 'Reg Basis', colRegBasis, 2)
pRegU = plot(upperCh,  'Reg Upper', colRegUpper, 1)
pRegL = plot(lowerCh,  'Reg Lower', colRegLower, 1)
fill(pRegU, pRegL, color = colRegFill, title = 'Regression Channel Fill')

plot(avwap1, 'Anchored VWAP #1', color = colAVWAP,                     linewidth = 2)
plot(avwap2, 'Anchored VWAP #2', color = color.new(colAVWAP, 45), linewidth = 2, style = plot.style_linebr)

// ═══════════════════════════════════════════════════════════════════
// ZONE-ENTRY LABELS
// ═══════════════════════════════════════════════════════════════════

var int lastDiscountBar = na
var int lastPremiumBar  = na

if showTags and barstate.isconfirmed
    float  pctVal = math.round(pctFrom200 * 100, 1)
    string pctStr = (pctVal >= 0 ? '+' : '') + str.tostring(pctVal) + '%'

    if enteredDiscount and (na(lastDiscountBar) or bar_index - lastDiscountBar >= labelCooldown)
        label.new(bar_index, low, 'Discount ' + pctStr,
             color = color.new(color.rgb(0, 150, 0), 70), style = label.style_label_up,
             textcolor = color.white, size = size.tiny)
        lastDiscountBar := bar_index

    if enteredPremium and (na(lastPremiumBar) or bar_index - lastPremiumBar >= labelCooldown)
        label.new(bar_index, high, 'Premium ' + pctStr,
             color = color.new(color.rgb(150, 0, 0), 70), style = label.style_label_down,
             textcolor = color.white, size = size.tiny)
        lastPremiumBar := bar_index

// ═══════════════════════════════════════════════════════════════════
// ALERTS
// ═══════════════════════════════════════════════════════════════════

alertcondition(enteredDiscount, title = 'Entered Discount Zone',
     message = 'Discount Zone Entry: price below regression lower band or below -threshold vs SMA Slow.')
alertcondition(enteredPremium,  title = 'Entered Premium Zone',
     message = 'Premium Zone Entry: price above regression upper band and above +threshold vs SMA Slow.')
